{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,
  "modules-left": ["hyprland/workspaces", "memory", "cpu", "temperature"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "group/tray-expander",
    "custom/asus_control",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery",
    "clock",
    "custom/power",
  ],
  "hyprland/window": {
    "format": "{class}",
  },
  "hyprland/workspaces": {
    "on-click": "hyprctl dispatch workspace,id:{id}",
    "format": "{id}",
    "persistent-workspaces": {
      "HDMI-A-1": [5, 6, 7, 8],
      "eDP-2": [1, 2, 3, 4]
    }
  },
  "clock": {
    "format": "{:L%H:%M} ",
    "tooltip": true,
    "tooltip-format": "{:L%A, %d %B %Y}",
    "on-click": "merkuro-calendar",
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "kitty -e wlctl",
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "",
    "format-alt": "{time} {icon}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": ["", "", "", "", ""],
  },
  "bluetooth": {
    "format": "   ",
    "format-disabled": "  󰂲 ",
    "format-connected": "  󰂱 ",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueberry",
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-muted": " ",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""],
    },
    "on-click": "kitty -e wiremix",
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 12,
    "spacing": 17,
  },
  "custom/asus_control": {
    "exec": "~/.config/waybar/modules/asus_controls.sh",
    "return-type": "json",
    "interval": "once",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/modules/asus_control_menu.sh",
    "signal": 8,
  },
  "memory": {
    "format": "{}% ",
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false,
  },
  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "on-click": "rofi -show p -modi p:rofi-power-menu",
  },
  "temperature": {
    "thermal-zone": 1, // Optional:, often found in /sys/class/thermal/
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input", // Run 'ls /sys/class/hwmon/' to find yours
    "critical-threshold": 80, // Celsius
    "format-critical": "{temperatureC}°C {icon}",
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""],
  },
}
